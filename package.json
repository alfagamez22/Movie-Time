{
  "name": "papiflix",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "npm run clean && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/config.test.mjs tests/anime-episodes.test.mjs tests/vidnest-schema.test.mjs tests/kitsu-client.test.mjs tests/jikan-client.test.mjs tests/resolve-streaming-id.test.mjs tests/watch-history.test.mjs tests/manga-routes.test.mjs tests/auth-oauth.test.mjs tests/user-actions.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run build",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "hashids": "^2.3.0",
    "hls.js": "^1.6.16",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "lucide-react": "^1.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
