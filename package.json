{
  "name": "papiflix",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "db:migrate:couchbase": "node scripts/migrate-postgres-to-couchbase.mjs",
    "db:indexes:couchbase": "node scripts/setup-couchbase-indexes.mjs",
    "db:split:couchbase": "node scripts/split-couchbase-collections.mjs",
    "db:verify:couchbase": "node scripts/verify-couchbase-migration.mjs",
    "lint": "eslint .",
    "test": "node --test tests/config.test.mjs tests/embed-url.test.mjs tests/anime-episodes.test.mjs tests/tmdb-release-filter.test.mjs tests/tmdb-sections.test.mjs tests/watch-history.test.mjs tests/image-disk-cache.test.mjs tests/recently-watched-tombstone.test.mjs tests/manga-routes.test.mjs tests/auth-oauth.test.mjs tests/user-actions.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run build",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "couchbase": "^4.7.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "hashids": "^2.3.0",
    "hls.js": "^1.6.16",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "lucide-react": "^1.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
