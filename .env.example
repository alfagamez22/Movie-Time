NEXT_PUBLIC_APP_NAME="PapiFlix"
NEXT_PUBLIC_APP_DESCRIPTION="Stream your Favorite Movies and TV Shows for Free"
# Use the deployed public origin here so Discord, Facebook, and other crawlers can fetch social preview images.
# Vercel deployments can also fall back to VERCEL_PROJECT_PRODUCTION_URL when this is left local.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
EZVID_EMBED_BASE_URL="https://ezvidapi.com/embed"
MULTIEMBED_BASE_URL="https://multiembed.mov"
FILMU_EMBED_BASE_URL="https://embed.filmu.in"
VIDFAST_EMBED_BASE_URL="https://vidfast.net"
VIDKING_EMBED_BASE_URL="https://www.vidking.net/embed"
ANILIST_GRAPHQL_URL="https://graphql.anilist.co"
ANILIST_CLIENT_ID=""

# Set to "1" to include adult (18+) anime in search and browse
NEXT_PUBLIC_ANIME_INCLUDE_ADULT="0"

# PapiManga — MangaDex public REST API. No auth required for search/reading.
MANGADEX_API_BASE_URL="https://api.mangadex.org"
MANGADEX_CDN_ORIGIN="https://uploads.mangadex.org"

VIDAPI_EMBED_BASE_URL="https://vidapi.xyz/embed"
VIDSRC_EMBED_BASE_URL="https://vidsrc.to/embed"
YOUTUBE_EMBED_BASE_URL="https://www.youtube.com/embed"
YOUTUBE_THUMBNAIL_BASE_URL="https://img.youtube.com/vi"
YOUTUBE_WATCH_BASE_URL="https://www.youtube.com/watch"

# Prefer the TMDB read access token. Keep the API key as a fallback.
TMDB_API_TOKEN=""
TMDB_API_KEY=""

# Prisma Postgres — MUST use sslmode=verify-full. Any other mode (prefer/require/verify-ca)
# triggers a pg-connection-string deprecation warning in Vercel logs. Example:
#   postgres://USER:PASS@pooled.db.prisma.io:5432/postgres?sslmode=verify-full
# Fallback if verify-full is rejected by the server:
#   postgres://USER:PASS@pooled.db.prisma.io:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=""
