NEXT_PUBLIC_APP_NAME="PapiFlix"
NEXT_PUBLIC_APP_DESCRIPTION="TMDB-powered movie and TV library with multi-source playback"
# Use the deployed public origin here so Discord, Facebook, and other crawlers can fetch social preview images.
# Vercel deployments can also fall back to VERCEL_PROJECT_PRODUCTION_URL when this is left local.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
VIDFAST_EMBED_BASE_URL="https://vidfast.net"
VIDKING_EMBED_BASE_URL="https://www.vidking.net/embed"
ANILIST_GRAPHQL_URL="https://graphql.anilist.co"
VIDNEST_ANIME_API_BASE_URL="https://new.vidnest.fun"
# CDN origins for the VidNest proxy. Set these to the host of the .m3u8 and
# segment URLs that the VidNest JSON API returns for each source.
ANIWAVE_CDN_ORIGIN="https://megaplay.buzz"
ANITAKU_CDN_ORIGIN="https://anitaku.to"
ANI_ZIP_API_BASE_URL="https://api.ani.zip"
# PapiAnime alternate catalog sources for Players 4 (Kitsu) and 5 (Jikan/MAL).
# Both are public, no-auth REST APIs. Defaults work fine.
KITSU_API_BASE_URL="https://kitsu.app/api/edge"
JIKAN_API_BASE_URL="https://api.jikan.moe/v4"

# Prefer the TMDB read access token. Keep the API key as a fallback.
TMDB_API_TOKEN=""
TMDB_API_KEY=""
